# ===== 模型（2026-11 DeepSeek 官方模型）=====
# 主模型：deepseek-flash（DeepSeek-V4.1-Flash）或 deepseek-v4-pro
DEEPSEEK_API_KEY=
LLM_MODEL=deepseek-flash
LLM_BASE_URL=https://api.deepseek.com

# 思考模式：带工具调用时建议关闭，避免 reasoning_content 未回传导致 400
LLM_THINKING=false
LLM_REASONING_EFFORT=high
# 单次输出上限：默认 4096，报告/长文场景可调到 8192~16384
LLM_MAX_TOKENS=8192

# 联网搜索：Responses API 的 web_search 仅 deepseek-v4-pro 支持
WEB_SEARCH_MODEL=deepseek-v4-pro
DEEPSEEK_RESPONSES_URL=https://api.deepseek.com/responses

# 可选：请求追踪头（两个都填才生效；header 名按网关要求填写）
DEEPSEEK_TRACKING_ID=
DEEPSEEK_TRACKING_HEADER=

# ===== 平台与 MCP =====
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=erp_agent
ERP_BASE_URL=http://localhost:8080
MCP_SERVER_URL=http://localhost:8001
MCP_PORT=8001
# 仅本地直连平台时需要；容器内由 compose 注入，必须与平台 AGENT_INTERNAL_TOKEN 一致（>=32 位）
AGENT_INTERNAL_TOKEN=

SANDBOX_IMAGE=python:3.11-slim

# ===== 三层记忆（HOT / WARM / COLD，均可不配，走默认值）=====
# 情节记忆在 WARM 层停留天数，超过后只在 COLD 按需检索
MEMORY_WARM_EPISODE_DAYS=7
# 情节记忆保留天数，过期后被遗忘（硬删除）
MEMORY_EPISODE_TTL_DAYS=90
# COLD 层单次检索返回条数
MEMORY_RETRIEVAL_K=5
# 每位用户最多保留的情节条数
MEMORY_MAX_EPISODES=200
# 是否向 Agent 暴露 read_memory / remember 工具
MEMORY_TOOLS_ENABLED=true
# 是否启用 LLM 抽取偏好（默认关闭，走零成本确定性规则）
MEMORY_LLM_EXTRACTION=false

# ===== RAG / 知识库 =====
# Qdrant 与 bge-m3（本地 CPU）。首次检索会自动下载模型，约 2.2GB。
QDRANT_URL=http://localhost:6333
KB_COLLECTION=procurement_kb
KB_EMBEDDING_MODEL=BAAI/bge-m3
KB_EMBEDDING_DEVICE=cpu
KB_TOP_K=8
KB_MIN_SCORE=0.40
# 国内网络可启用 HF 镜像
HF_ENDPOINT=https://hf-mirror.com
# 本地模型缓存目录（可选；容器内由 compose 覆盖为 /data/hf）
# HF_HOME=

# 工具调用追踪文件（可选，默认 logs/tool_trace.jsonl）
# TOOL_TRACE_FILE=logs/tool_trace.jsonl

# ===== 审查路由 =====
# 默认保留 DeepSeek；可选 jev（独立于主 Agent / Grader）
REVIEW_ROUTER_PROVIDER=deepseek
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-1.13.0
